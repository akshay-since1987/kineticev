# Environment Variables for Load Testing

# Target URLs
PRODUCTION_URL=https://www.kineticev.in
DEV_URL=http://dev.kineticev.in
BLOG_URL=https://blog.kineticev.in

# Test Configuration
MAX_VIRTUAL_USERS=500
TEST_DURATION=300
RAMP_UP_TIME=30

# Monitoring
MONITOR_INTERVAL=5000
ALERT_THRESHOLD_MS=2000
ERROR_THRESHOLD_PERCENT=5

# Database (if testing locally)
DB_HOST=localhost
DB_NAME=kineticev_test
DB_USER=test_user
DB_PASS=test_password

# Test Data
USE_TEST_PHONE_NUMBERS=true
SEND_REAL_SMS=false
SKIP_OTP_VERIFICATION=true

# Performance Thresholds
MAX_RESPONSE_TIME=2000
MAX_ERROR_RATE=5
MIN_THROUGHPUT=50